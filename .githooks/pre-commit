#!/bin/sh
# Format and lint staged files, then re-stage them. Shared across Organized projects
# (source: hub new-project starter).
#   Markdown          markdownlint-cli2 --fix                 never blocks
#   JS/TS/CSS/HTML    prettier --write, then oxlint --fix     blocks on oxlint errors
#   Python            ruff format, then ruff check --fix      blocks on ruff errors
#   CSS (jeff-ui apps) jeff-ui-css-check                      blocks on raw colors, .ui-* selectors,
#                                                             :root custom properties; prints line counts
# A missing tool skips its step with a note (jeff-ui-css-check silently: only jeff-ui apps have it).
# Setup, once per clone: git config core.hooksPath .githooks
# Tools: npm i -g markdownlint-cli2@0.13.0; prettier and oxlint are devDependencies (npm install);
# ruff runs through uvx at the version below.
# After fixing a lint error by hand, add how to avoid it to .claude/rules/LINT.md.

RUFF=ruff@0.17.6

list=$(mktemp)
trap 'rm -f "$list"' EXIT
status=0

# Staged (added, copied, modified) files matching the given patterns, NUL-separated, into $list.
staged() {
  git diff --cached --name-only -z --diff-filter=ACM -- "$@" > "$list"
  [ -s "$list" ]
}

# Path to a JS tool: the project's node_modules first (root or app/), then PATH.
js_tool() {
  for p in "node_modules/.bin/$1" "app/node_modules/.bin/$1"; do
    if [ -x "$p" ]; then echo "$p"; return; fi
  done
  command -v "$1" 2>/dev/null
}

if staged '*.md'; then
  if command -v markdownlint-cli2 >/dev/null 2>&1; then
    xargs -0 markdownlint-cli2 --fix < "$list" >/dev/null 2>&1
    xargs -0 git add < "$list"
  else
    echo "pre-commit: markdownlint-cli2 not found; skipping Markdown (npm i -g markdownlint-cli2@0.13.0)" >&2
  fi
fi

if staged '*.ts' '*.tsx' '*.js' '*.jsx' '*.mjs' '*.cjs' '*.css' '*.html'; then
  prettier=$(js_tool prettier)
  if [ -n "$prettier" ]; then
    xargs -0 "$prettier" --write --log-level warn < "$list"
    xargs -0 git add < "$list"
  else
    echo "pre-commit: prettier not found; skipping JS/TS format (npm install)" >&2
  fi
fi

if staged '*.ts' '*.tsx' '*.js' '*.jsx' '*.mjs' '*.cjs'; then
  oxlint=$(js_tool oxlint)
  if [ -n "$oxlint" ]; then
    xargs -0 "$oxlint" -c .oxlintrc.json --fix --quiet < "$list" || status=1
    xargs -0 git add < "$list"
  else
    echo "pre-commit: oxlint not found; skipping JS/TS lint (npm install)" >&2
  fi
fi

if staged '*.css'; then
  css_check=$(js_tool jeff-ui-css-check)
  if [ -n "$css_check" ]; then
    xargs -0 "$css_check" < "$list" || status=1
  fi
fi

if staged '*.py'; then
  if command -v uvx >/dev/null 2>&1; then
    xargs -0 uvx "$RUFF" format --quiet < "$list"
    xargs -0 uvx "$RUFF" check --fix --quiet < "$list" || status=1
    xargs -0 git add < "$list"
  else
    echo "pre-commit: uvx not found; skipping Python format and lint (install uv)" >&2
  fi
fi

if [ "$status" -ne 0 ]; then
  echo "pre-commit: lint errors above block this commit. Fix them, then add how to avoid each" >&2
  echo "pre-commit: one to .claude/rules/LINT.md." >&2
fi
exit "$status"
