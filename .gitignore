node_modules/
dist/
dist-keys/
coverage/

# Ephemeral render output — regenerated from composition specs, never source of truth
exports/*
!exports/.gitkeep

# SoundFont / sample packs are large binaries; fetch locally, don't commit
assets/samples/*
!assets/samples/.gitkeep

# Guitar takes are large, personal, and not the source of truth — the transcription
# they produce is. Keep the folder and its capture rules; drop the audio.
#
# Only .wav can actually be transcribed (see recordings/README.md). The other
# formats are listed because a take *arrives* as one — a phone memo dropped in
# here on the way to being converted is exactly the large binary this is for, and
# it should not be committed while it waits.
recordings/**/*.wav
recordings/**/*.aiff
recordings/**/*.aif
recordings/**/*.flac
recordings/**/*.m4a
recordings/**/*.mp3

# Local env / editor
.env
.env.local
.DS_Store
*.log

# Deleted compositions are moved here by the bench, not unlinked — recoverable, not committed
compositions/_trash/

# Full-quality WAVs from `npm run render -- --wav` — MP3s beside them are committed.
public/audio
public/audio/*.wav
public/audio/*.mp3
public/audio/voices/*.wav
public/audio/voices/*.mp3

# Work plans are tracked: tasks/<name>/PLAN.md, TODO.md and steps/. Everything else in
# a task folder (commission output: rendered MP3s, piece JSON) stays local.
tasks/**
!tasks/*/
!tasks/*/PLAN.md
!tasks/*/TODO.md
!tasks/*/steps/
!tasks/*/steps/*.md
# Backlog notes are tracked: tasks/backlog/<name>.md and parked task folders' plans.
!tasks/backlog/*.md
!tasks/backlog/*/
!tasks/backlog/*/PLAN.md
!tasks/backlog/*/TODO.md
!tasks/backlog/*/steps/
!tasks/backlog/*/steps/*.md
compositions/
manifest/
public/*/**

# Registry and logs of scripts/run.ts
.run/
