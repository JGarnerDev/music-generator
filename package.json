{
  "name": "music-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Conversational, code-driven lo-fi music generator. Describe a mood or scene; Claude composes; the browser plays and exports WAV.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "palette:new": "tsx scripts/new-palette.ts",
    "composition:validate": "tsx scripts/validate-composition.ts"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "gray-matter": "^4.0.3",
    "smplr": "^1.0.0",
    "tonal": "^6.4.3",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
