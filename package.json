{
  "name": "music-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Conversational, code-driven lo-fi music generator. Describe a mood or scene; Claude composes; the browser plays and exports WAV.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "compose": "tsx scripts/compose.ts",
    "song:build": "tsx scripts/build-song.ts",
    "render": "tsx scripts/render.ts",
    "palette:new": "tsx scripts/new-palette.ts",
    "palette:tree": "tsx scripts/palette-tree.ts",
    "composition:validate": "tsx scripts/validate-composition.ts",
    "compositions:organize": "tsx scripts/organize-compositions.ts",
    "voice:new": "tsx scripts/new-voice.ts",
    "voice:find": "tsx scripts/find-voice.ts",
    "voice:render": "tsx scripts/render-voices.ts",
    "voice:approve": "tsx scripts/approve-voice.ts"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "gray-matter": "^4.0.3",
    "smplr": "^1.0.0",
    "tonal": "^6.4.3",
    "tone": "^15.1.22",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@types/node": "^24.0.0",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
