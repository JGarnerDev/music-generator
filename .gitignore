node_modules/
dist/
coverage/

# Ephemeral render output — regenerated from composition specs, never source of truth
exports/*
!exports/.gitkeep

# SoundFont / sample packs are large binaries; fetch locally, don't commit
assets/samples/*
!assets/samples/.gitkeep

# Local env / editor
.env
.env.local
.DS_Store
*.log

# Deleted compositions are moved here by the bench, not unlinked — recoverable, not committed
compositions/_trash/

# Full-quality WAVs from `npm run render -- --wav` — MP3s beside them are committed.
public/audio
public/audio/*.wav
public/audio/*.mp3
public/audio/voices/*.wav
public/audio/voices/*.mp3

tasks/